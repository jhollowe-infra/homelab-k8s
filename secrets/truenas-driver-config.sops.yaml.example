# Template for secrets/truenas-driver-config.sops.yaml - a Kubernetes
# Secret manifest, encrypted with sops (only the *values* under stringData
# need protecting; sops can encrypt the whole file, which is simplest).
#
# Usage:
#   cp secrets/truenas-driver-config.sops.yaml.example secrets/truenas-driver-config.sops.yaml
#   # fill in real values below
#   sops -e -i secrets/truenas-driver-config.sops.yaml
#
# Applied manually during cluster-bootstrap (see
# cluster-bootstrap/democratic-csi-truenas-values.yaml):
#   kubectl apply -f <(sops -d secrets/truenas-driver-config.sops.yaml) -n democratic-csi
#
# driver: freenas-api-nfs is for TrueNAS SCALE (21.08+). If you're on
# TrueNAS CORE instead, use freenas-nfs and add an sshConnection block -
# see cluster-bootstrap/democratic-csi-truenas-values.yaml for why.
apiVersion: v1
kind: Secret
metadata:
  name: truenas-nfs-driver-config
  namespace: democratic-csi
type: Opaque
stringData:
  driver-config-file.yaml: |
    driver: freenas-api-nfs
    instance_id:
    httpConnection:
      protocol: https
      host: truenas.lan
      port: 443
      apiKey: "REPLACE_WITH_TRUENAS_API_KEY"
      allowInsecure: false
    zfs:
      datasetParentName: tank/k8s/nfs/vols
      detachedSnapshotsDatasetParentName: tank/k8s/nfs/snaps
      datasetEnableQuotas: true
      datasetEnableReservation: false
      datasetPermissionsMode: "0777"
      datasetPermissionsUser: 0
      datasetPermissionsGroup: 0
    nfs:
      shareHost: truenas.lan
      shareAlldirs: false
      shareAllowedNetworks:
        - 192.168.1.0/24 # REPLACE with your k8s node subnet
      shareMaprootUser: root
      shareMaprootGroup: wheel
