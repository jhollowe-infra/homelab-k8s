// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/alpine
{
	"name": "Homelab K8s Dev Container",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:alpine3.23",
	"features": {
		"ghcr.io/devcontainers/features/nix:1": {
			"multiUser": true,
			"version": "latest",
			"packages": "nixd,nixfmt",
			"extraNixConfig": "experimental-features = nix-command flakes",
			// "flakeUri": "github:jhollowe-infra/homelab-k8s",
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"HashiCorp.terraform",
				"jnoortheen.nix-ide",
				"mhutchie.git-graph",
				"ms-kubernetes-tools.vscode-kubernetes-tools",
				"redhat.vscode-yaml",
				"signageos.signageos-vscode-sops",
			],
			"settings": {
				"nix.enableLanguageServer": true,
			}
		}
	},
	"containerEnv": {
		"SOPS_AGE_KEY_FILE": "/workspaces/homelab-k8s/age-key.txt"
	},
	// The first time the dev container runs, install the flake's packages
	"postCreateCommand": "nix profile add .",
}
