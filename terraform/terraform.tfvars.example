# Copy to terraform.tfvars (gitignored) and fill in real values.

proxmox_endpoint  = "https://pve1.lan:8006/"
proxmox_api_token = "terraform@pve!homelab-k8s=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
proxmox_insecure  = true # true if using Proxmox's self-signed cert

# quicksync_pci_id / nvidia_pci_id are both optional - leave unset for
# nodes with no PCI passthrough. When used, find the PCI ID by running
# `lspci -nn` on that physical Proxmox host (not in a VM). The iGPU is
# usually "00:02.0", the discrete GPU will be on its own bus address, e.g.
# "01:00.0". Terraform wants full domain form: "0000:00:02.0".
# longhorn_disk_gb defaults to 4 (deliberately small - see
# nixos-modules/longhorn-disk-grow.nix and longhorn-disk-alert.nix). To
# grow a node's disk later, just raise its number here and `tofu apply`;
# the node alerts you via Discord at 80% used and auto-grows into the new
# space within 15 minutes.
nodes = {
  k8s-node-1 = {
    proxmox_node = "pve1"
    vm_id        = 101
    ip_address   = "10.10.100.10/16"
  }
  k8s-node-2 = {
    proxmox_node = "pve2"
    vm_id        = 102
    ip_address   = "10.10.100.11/16"
  }
  k8s-node-3 = {
    proxmox_node = "pve3"
    vm_id        = 103
    ip_address   = "10.10.100.12/16"
  }
}
