# Template for secrets/secrets.sops.yaml, referenced via sops-nix by:
#   - nixos-modules/k3s.nix (k3s-token)
#   - nixos-modules/longhorn-disk-alert.nix (discord-webhook-url-resources)
#   - nixos-modules/oom-alert.nix (discord-webhook-url-resources)
#
# The discord-webhook-url-* fields are the 4 alert categories decided in
# homelab-apps's TODO/alerting.md ("Notification channels/categories"):
# resources, cluster-infra, cluster-apps, misc - one Discord
# webhook/channel each. Only discord-webhook-url-resources is actually
# consumed by this repo today (longhorn-disk-alert.nix, oom-alert.nix).
# The other 3 are provisioned here so all 4 Discord webhooks can be
# created and filled in at once; cluster-infra/cluster-apps are expected
# to mainly be consumed by homelab-apps's future Alertmanager config
# instead, once that exists.
#
# Do NOT edit this .example file with real values. Instead:
#   cp secrets/secrets.sops.yaml.example secrets/secrets.sops.yaml
#   # edit secrets/secrets.sops.yaml with real values, e.g.:
#   #   k3s-token: output of `openssl rand -hex 32`
#   #   discord-webhook-url-*: a Discord channel's Integrations -> Webhooks URL
#   sops -e -i secrets/secrets.sops.yaml
#
# secrets/secrets.sops.yaml (once encrypted) IS meant to be committed -
# that's the point of sops: ciphertext in git, only your age key decrypts it.

k3s-token: "REPLACE_WITH_A_RANDOM_TOKEN"
discord-webhook-url-resources: "REPLACE_WITH_YOUR_DISCORD_WEBHOOK_URL"
discord-webhook-url-cluster-infra: "REPLACE_WITH_YOUR_DISCORD_WEBHOOK_URL"
discord-webhook-url-cluster-apps: "REPLACE_WITH_YOUR_DISCORD_WEBHOOK_URL"
discord-webhook-url-misc: "REPLACE_WITH_YOUR_DISCORD_WEBHOOK_URL"
